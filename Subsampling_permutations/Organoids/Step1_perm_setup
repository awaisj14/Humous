# Helper to annotate and filter each dataset
filter_cells <- function(obj, dataset_name) {
  obj$age_ek <- DiffTypes_org$age[base::match(base::colnames(obj), DiffTypes_org$cells)]
  obj$diff_ek <- DiffTypes_org$DiffTypes[base::match(base::colnames(obj), DiffTypes_org$cells)]
  obj$protocol <- DiffTypes_org$proto[base::match(base::colnames(obj), DiffTypes_org$cells)]
  obj$dataset <- dataset_name
  obj$dataset_proto <- base::paste0(dataset_name, "_", obj$protocol)
  subset(obj, diff_ek %in% c("RG", "IPC", "N") & age_ek %in% c("1-2 m", "2-3 m", "3 m", "3.5-5 m", "6-7 m"))
}

full.list <- base::lapply(base::names(full.list), function(ds) filter_cells(full.list[[ds]], ds))
